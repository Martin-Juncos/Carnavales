# Configuración de la API local (copiar a .env si se necesita cambiar algo).
# Estos valores son de demostración y no deben usarse en producción.

HOST=127.0.0.1
PORT=4000

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Cuenta demo del jurado.
DEMO_EMAIL=jurado@carnavalesgoyanos.gob.ar
DEMO_PASSWORD=carnaval2027

# Si se define, el código de acceso siempre vale este valor (útil para demos).
# Si queda vacío, se genera uno aleatorio y se imprime en la terminal.
DEV_ACCESS_CODE=
